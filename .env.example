# ======================================
# CivicAI — Environment Variables
# ======================================
# Copy this file to .env and fill in real values.
# .env is ignored by Git. This template is committed.
#
# All frontend-exposed variables MUST start with VITE_
# See: https://vite.dev/guide/env-and-mode
# ======================================

# --- Application ---
VITE_APP_NAME=CivicAI
VITE_APP_ENV=development

# --- Backend API ---
VITE_API_BASE_URL=

# --- AI Service ---
VITE_AI_API_KEY=

# --- Speech-to-Text ---
VITE_SPEECH_API_KEY=

# --- Translation ---
VITE_TRANSLATION_API_KEY=

# --- Maps ---
VITE_MAPS_API_KEY=
